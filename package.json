{
  "name": "wbw-kawaii",
  "displayName": "wbw121124's kawaii 报错文案",
  "description": "把 C/C++ / TypeScript / CSS / HTML 的报错文案就地改写成可爱风格：规则表 + 正则兜底，全版本有效",
  "version": "0.3.0",
  "publisher": "wbw121124",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/wbw121124/wbw-kawaii"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cpptools",
    "kawaii",
    "cute",
    "typescript",
    "css",
    "html",
    "error",
    "vscode"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "wbw-kawaii.patch",
        "title": "Kawaii: 重新改写报错文案"
      },
      {
        "command": "wbw-kawaii.restore",
        "title": "Kawaii: 还原原始报错文案"
      },
      {
        "command": "wbw-kawaii.status",
        "title": "Kawaii: 查看改写状态与覆盖率"
      },
      {
        "command": "wbw-kawaii.cyclePersona",
        "title": "Kawaii: 切换人设风格"
      },
      {
        "command": "wbw-kawaii.whimper",
        "title": "Kawaii: 示弱彩蛋"
      }
    ],
    "configuration": {
      "title": "wbw kawaii",
      "properties": {
        "wbw-kawaii.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用自动改写（启动及 cpptools 版本变化时对 messages.json 就地改写）"
        },
        "wbw-kawaii.fallbackDecorate": {
          "type": "boolean",
          "default": true,
          "description": "对规则表未命中的文案用正则追加统一可爱后缀（命中规则表的条目不受影响）"
        },
        "wbw-kawaii.promptReload": {
          "type": "boolean",
          "default": true,
          "description": "改写/还原后弹出通知，提示重载窗口使新文案生效"
        },
        "wbw-kawaii.enableMarkdownlint": {
          "type": "boolean",
          "default": true,
          "description": "启用 markdownlint 报错可爱化（运行时拦截）"
        },
        "wbw-kawaii.enablePylint": {
          "type": "boolean",
          "default": true,
          "description": "启用 pylint 报错可爱化（运行时拦截）"
        },
        "wbw-kawaii.personaStyle": {
          "type": "string",
          "enum": [
            "soft",
            "tsundere",
            "derriere",
            "cool"
          ],
          "default": "soft",
          "description": "人设风格：soft=软萌, tsundere=傲娇, derriere=毒舌, cool=冷淡可爱"
        },
        "wbw-kawaii.kawaiiIntensity": {
          "type": "string",
          "enum": [
            "subtle",
            "normal",
            "bold"
          ],
          "default": "normal",
          "description": "可爱强度：subtle=微妙, normal=标准, bold=重度"
        },
        "wbw-kawaii.targets": {
          "type": "object",
          "default": {
            "cpptools": true,
            "typescript": true,
            "cssHtml": true,
            "markdownlint": true,
            "pylint": true
          },
          "description": "按目标启用可爱化"
        },
        "wbw-kawaii.customFallback": {
          "type": "string",
          "default": null,
          "description": "自定义兜底后缀，覆盖人设风格选择"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "wbw-kawaii.patch",
          "when": "editorFocus && resourceLangId == typescript || editorFocus && resourceLangId == javascript || editorFocus && resourceLangId == cpp || editorFocus && resourceLangId == c",
          "group": "1_modification"
        },
        {
          "command": "wbw-kawaii.status",
          "when": "editorFocus",
          "group": "z_commands"
        }
      ]
    }
  },
  "scripts": {
    "fetch-baseline": "node scripts/fetch-baseline.mjs",
    "build:rules": "node scripts/build-rules.mjs",
    "extract:inputs": "node scripts/extract-rule-inputs.mjs",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "tsc -p ./ && node --test test/transform.test.cjs test/uninstall-restore.test.cjs test/new-targets.test.cjs",
    "package": "vsce package",
    "vscode:uninstall": "node ./out/uninstall-restore.js",
    "build:rules:check": "node scripts/build-rules.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0"
  }
}